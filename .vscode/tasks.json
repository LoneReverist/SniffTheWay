      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-release",
        "--target",
        "SniffTheWay"
      ],
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d", "/c", "call \"C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\Common7\\Tools\\VsDevCmd.bat\" -arch=x64 -host_arch=x64 >nul 2>&1 &&"
          ]
        }
      },
      "dependsOn": "Configure Release Windows",
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}