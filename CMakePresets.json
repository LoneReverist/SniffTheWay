{
	"version": 8,
	"configurePresets": [
		{
			"name": "default",
			"description": "Default build on Windows",
			"inherits": "x64-windows-static"
		},
		{
			"name": "x64-windows-static",
			"description": "Static Windows build using vcpkg",
			"generator": "Visual Studio 18 2026",
			"architecture": "x64",
			"binaryDir": "${sourceDir}/build",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
				"VCPKG_TARGET_TRIPLET": "x64-windows-static",
				"VCPKG_APPLOCAL_DEPS": "OFF",
				"SNIFF_THE_WAY_RENDERER": "Vulkan"
			}
		},
		{
			"name": "package-windows-vulkan",
			"description": "Isolated Vulkan build used for Windows release packages",
			"inherits": "x64-windows-static",
			"binaryDir": "${sourceDir}/build-package/vulkan",
			"cacheVariables": {
				"SNIFF_THE_WAY_RENDERER": "Vulkan"
			}
		},
		{
			"name": "package-windows-opengl",
			"description": "Isolated OpenGL build used for Windows release packages",
			"inherits": "x64-windows-static",
			"binaryDir": "${sourceDir}/build-package/opengl",
			"cacheVariables": {
				"SNIFF_THE_WAY_RENDERER": "OpenGL"
			}
		},
		{
			"name": "x64-windows-clang-debug",
			"description": "Debug Windows build using Ninja, vcpkg, and Visual Studio bundled Clang",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build-clangwin",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_C_COMPILER": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang.exe",
				"CMAKE_CXX_COMPILER": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang++.exe",
				"CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang-scan-deps.exe",
				"CMAKE_CXX_COMPILER_CLANG_RESOURCE_DIR": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/lib/clang/20",
				"CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
				"VCPKG_TARGET_TRIPLET": "x64-windows-static",
				"VCPKG_APPLOCAL_DEPS": "OFF"
			}
		},
		{
			"name": "x64-windows-clang-release",
			"description": "Release Windows build using Ninja, vcpkg, and Visual Studio bundled Clang",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build-clangwin-release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_C_COMPILER": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang.exe",
				"CMAKE_CXX_COMPILER": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang++.exe",
				"CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang-scan-deps.exe",
				"CMAKE_CXX_COMPILER_CLANG_RESOURCE_DIR": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/lib/clang/20",
				"CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
				"VCPKG_TARGET_TRIPLET": "x64-windows-static",
				"VCPKG_APPLOCAL_DEPS": "OFF"
			}
		},
		{
			"name": "x64-linux",
			"description": "Linux build using vcpkg",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake",
				"VCPKG_TARGET_TRIPLET": "x64-linux"
			}
		}
	],
	"buildPresets": [
		{
			"name": "default",
			"configurePreset": "default",
			"targets": [
				"SniffTheWay"
			]
		},
		{
			"name": "x64-windows-static-release",
			"configurePreset": "x64-windows-static",
			"configuration": "Release",
			"targets": [
				"SniffTheWay"
			]
		},
		{
			"name": "x64-windows-static-debug",
			"configurePreset": "x64-windows-static",
			"configuration": "Debug",
			"targets": [
				"SniffTheWay"
			]
		},
		{
			"name": "package-windows-vulkan-release",
			"configurePreset": "package-windows-vulkan",
			"configuration": "Release",
			"jobs": 1,
			"targets": [
				"SniffTheWay"
			]
		},
		{
			"name": "package-windows-opengl-release",
			"configurePreset": "package-windows-opengl",
			"configuration": "Release",
			"jobs": 1,
			"targets": [
				"SniffTheWay"
			]
		},
		{
			"name": "x64-windows-clang-debug",
			"configurePreset": "x64-windows-clang-debug",
			"targets": [
				"SniffTheWay"
			]
		},
		{
			"name": "x64-windows-clang-release",
			"configurePreset": "x64-windows-clang-release",
			"targets": [
				"SniffTheWay"
			]
		}
	]
}
