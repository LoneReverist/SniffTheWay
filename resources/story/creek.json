          "show_time": 4.5
        }
      ]
    },
    {
      "background": "crossing_creek.png",
      "texts": [
        {
          "text": "But the dog lowered his nose",
          "font_size": 64.0,
          "pos": [960.0, 250.0],
          "align": "center",
          "show_time": 0.75
        },
        {
          "text": "and searched for the safest way.",
