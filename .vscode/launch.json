    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug SniffTheWay",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build SniffTheWay Debug",
            "program": "${workspaceFolder}/build-debug/SniffTheWay",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Release SniffTheWay",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build SniffTheWay Release",
            "program": "${workspaceFolder}/build-release/SniffTheWay",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false
        }
    ]
}